# Copia este archivo a .env.local (desarrollo) o configúralo en tu hosting (producción).
# URL pública final del sitio, sin "/" al final. Usada en sitemap, canonical y datos estructurados.
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# Opcional: códigos de verificación de Google Search Console y Bing Webmaster Tools
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
